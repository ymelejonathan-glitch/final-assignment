@model IEnumerable<CarInsurance.Models.Insurance>

@{
    ViewData["Title"] = "Admin View";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">Admin View - All Issued Quotes</h2>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email Address</th>
                <th>Calculated Quote</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No quotes found in the database.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.EmailAddress</td>
                        <td class="text-success fw-bold">@string.Format("{0:C}", item.Quote)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
